# Django Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://your-service.onrender.com

# Database (Leave empty for default SQLite in local development, or provide PostgreSQL URL)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Cloudinary Storage Credentials (Optional for local development, required for production media)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
